{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "appServiceSku": { "value": "${APP_SERVICE_SKU=B1}" },
    "entraTenantId": { "value": "${ENTRA_TENANT_ID}" },
    "apiClientId": { "value": "${API_CLIENT_ID}" },
    "azdoOrg": { "value": "${AZDO_ORG}" },
    "azdoProject": { "value": "${AZDO_PROJECT}" },
    "azdoPat": { "value": "${AZDO_PAT}" },
    "githubRepo": { "value": "${GITHUB_REPO}" },
    "githubDispatchToken": { "value": "${GITHUB_DISPATCH_TOKEN}" }
  }
}
