@using Dashboard.Shared

<figure class="chart">
    <figcaption class="chart-title">
        <span>@Title</span>
        @if (Points.Count > 0)
        {
            <span class="chart-current" style="color:@Color">@Points[^1].ToString(Format) @Unit</span>
        }
    </figcaption>
    <svg viewBox="0 0 @Width @Height" preserveAspectRatio="none" role="img" aria-label="@Title over the last @Points.Count seconds"
         @onmousemove="OnMove" @onmouseleave="() => _hover = null">
        @foreach (var g in GridLines())
        {
            <line x1="@Pad" x2="@(Width - Pad)" y1="@g.Y" y2="@g.Y" class="chart-grid" />
            @((MarkupString)$"<text x=\"{Pad - 6}\" y=\"{g.Y + 4:F1}\" class=\"chart-axis-label\" text-anchor=\"end\">{g.Label}</text>")
        }
        @if (Points.Count > 1)
        {
            <polyline points="@PolylinePoints()" fill="none" stroke="@Color" stroke-width="2"
                      stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        }
        @if (_hover is { } h)
        {
            <line x1="@h.X" x2="@h.X" y1="@Pad" y2="@(Height - Pad)" class="chart-crosshair" />
            <circle cx="@h.X" cy="@h.Y" r="4" fill="@Color" stroke="var(--surface)" stroke-width="2" />
        }
    </svg>
    @if (_hover is { } t)
    {
        <div class="chart-tooltip">@t.Time.ToLocalTime().ToString("HH:mm:ss") · @t.Value.ToString(Format) @Unit</div>
    }
</figure>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string Color { get; set; } = "#2a78d6";
    [Parameter] public string Format { get; set; } = "F0";
    [Parameter] public IReadOnlyList<double> Points { get; set; } = [];
    [Parameter] public IReadOnlyList<DateTimeOffset> Times { get; set; } = [];
    [Parameter] public double? Max { get; set; }

    private const double Width = 600;
    private const double Height = 160;
    private const double Pad = 28;
    private (double X, double Y, DateTimeOffset Time, double Value)? _hover;

    private double MaxValue => Max ?? Math.Max(1, Math.Ceiling(Points.DefaultIfEmpty(1).Max() * 1.1));

    private double XFor(int i) => Points.Count < 2 ? Pad : Pad + i * (Width - 2 * Pad) / (Points.Count - 1);
    private double YFor(double v) => Height - Pad - (v / MaxValue) * (Height - 2 * Pad);

    private string PolylinePoints() =>
        string.Join(" ", Points.Select((v, i) => $"{XFor(i):F1},{YFor(v):F1}"));

    private IEnumerable<(double Y, string Label)> GridLines()
    {
        for (var step = 0; step <= 4; step++)
        {
            var value = MaxValue * step / 4;
            yield return (YFor(value), value.ToString("F0"));
        }
    }

    private void OnMove(MouseEventArgs e)
    {
        if (Points.Count < 2)
        {
            return;
        }
        // offsetX is in CSS pixels of the rendered SVG; scale to the viewBox width.
        var index = (int)Math.Round((e.OffsetX / _renderedWidth) * (Points.Count - 1));
        index = Math.Clamp(index, 0, Points.Count - 1);
        var time = index < Times.Count ? Times[index] : DateTimeOffset.MinValue;
        _hover = (XFor(index), YFor(Points[index]), time, Points[index]);
    }

    // The SVG is rendered at 100% width; assume the container matches the viewBox aspect.
    // Good enough for a hover readout; the crosshair snaps to the nearest sample.
    private double _renderedWidth = Width;
}
